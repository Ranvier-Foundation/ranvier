# Origin of the Ranvier API the browser calls (scheme, host and port; any path is ignored).
# Read at BUILD time: it is baked into the CSP connect-src (nothing else), so changing it needs a
# rebuild. Unset: same-origin only. The API must list this app's origin in its WEB_ORIGINS.
# Production builds (next build) require https; plain http is accepted only for localhost,
# 127.0.0.1 and [::1].
NEXT_PUBLIC_API_URL=http://localhost:4000

# Wallet connection (ADR 0007) needs no environment variables. Browser wallets are found through
# EIP-6963 and nothing is read from the chain by the browser. WalletConnect (phone wallets) is
# not included yet, so there is no project id to set; when it is added it will be named here.
