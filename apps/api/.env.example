PORT=4000
HOST=127.0.0.1
# Per-provider budget. Real 0x latency is ~1.2s from a distant client; the p95 target
# (800ms) applies to a server in a datacenter near the providers.
PROVIDER_TIMEOUT_MS=2500
# Fee wrapper address (same on every EVM chain). Quotes are built for this contract as taker.
FEE_WRAPPER_ADDRESS=
# https://dashboard.0x.org
ZEROX_API_KEY=
# Chains quoted (and, with a signer, signed). With a local signing key these must be testnet
# or local chain IDs: the API refuses to start with a mainnet here and a local key set.
ZEROX_CHAIN_IDS=1,8453,42161
QUOTE_TTL_SECONDS=60
# Largest slippage a client may request, in bps (default 1000 = 10%, hard maximum 5000).
MAX_SLIPPAGE_BPS=1000
# Largest shortfall of a route's output oracle value against its input, in bps (default 500 = 5%).
MAX_ORACLE_DEVIATION_BPS=500
# Fee-quote signing key: DEVELOPMENT, TESTNETS AND LOCAL FORKS ONLY. Production uses a KMS signer.
# It never signs for a mainnet chain ID. For mainnet end-to-end tests use an Anvil fork under
# chain ID 31337 with a throwaway key. Must match the wrapper's feeSigner.
# Generate a throwaway key with: cast wallet new
QUOTE_SIGNER_PRIVATE_KEY=
# Chains the local key may sign for: a subset of 84532,11155111,421614,31337 (the default).
# Any other chain ID is refused at startup; it can narrow the set, never extend it.
LOCAL_SIGNER_CHAIN_IDS=
