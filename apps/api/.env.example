PORT=4000
HOST=127.0.0.1
# Per-provider budget. Real 0x latency is ~1.2s from a distant client; the p95 target
# (800ms) applies to a server in a datacenter near the providers.
PROVIDER_TIMEOUT_MS=2500
# Fee wrapper address (same on every EVM chain). Quotes are built for this contract as taker.
FEE_WRAPPER_ADDRESS=
# https://dashboard.0x.org
ZEROX_API_KEY=
# Chains quoted (and, with a signer, signed). With a local signing key these must be testnet
# or local chain IDs: the API refuses to start with a mainnet here and a local key set. With
# KMS_KEY_ID every chain here must have trusted routers (apps/api/src/trusted-routers.ts).
ZEROX_CHAIN_IDS=1,8453,42161
QUOTE_TTL_SECONDS=60
# Largest slippage a client may request, in bps (default 1000 = 10%, hard maximum 5000).
MAX_SLIPPAGE_BPS=1000
# Largest shortfall of a route's output oracle value against its input, in bps (default 500 = 5%).
MAX_ORACLE_DEVIATION_BPS=500
# Browser origins allowed to call the API (CORS), comma-separated exact origins: scheme, host
# and port only, lowercase, no path or trailing slash, no wildcard. Unset: no cross-origin
# access. Credentials are never allowed. With NODE_ENV=production, or with any mainnet in
# ZEROX_CHAIN_IDS (the default), every origin must be https, except loopback hosts (localhost,
# 127.0.0.1, [::1]). Example for the local web app:
# WEB_ORIGINS=http://localhost:3000
WEB_ORIGINS=
# Fee-quote signer: set exactly ONE of KMS_KEY_ID (production) or QUOTE_SIGNER_PRIVATE_KEY
# (development). The API refuses to start with both. See docs/runbooks/kms-setup.md.
#
# Production: AWS KMS key (ECC_SECG_P256K1, SIGN_VERIFY), as a key ARN or alias/... name.
# The only signer that may sign for mainnets, and only on chains with trusted routers.
# Credentials come from the default AWS provider chain (instance or task role, AWS_PROFILE);
# never put AWS access keys in this file.
# In production (NODE_ENV=production) or with any mainnet chain this must be the full key ARN.
KMS_KEY_ID=
# Address the KMS key must derive to (the wrapper's feeSigner, read from the key ARN as in the
# runbook). Required in production or with any mainnet chain; the API refuses to start otherwise
# or on a mismatch.
KMS_EXPECTED_SIGNER_ADDRESS=
# Region of the KMS key, e.g. eu-west-1. Required with KMS_KEY_ID.
AWS_REGION=
# Per KMS Sign call in ms (default 2000; one retry on throttling or transient errors).
KMS_SIGN_TIMEOUT_MS=2000
# Concurrent KMS Sign calls, and calls allowed to wait for one; beyond that quotes get 503.
KMS_MAX_IN_FLIGHT=16
KMS_MAX_QUEUE=64
#
# Fee-quote signing key: DEVELOPMENT, TESTNETS AND LOCAL FORKS ONLY. Production uses a KMS signer.
# It never signs for a mainnet chain ID. For mainnet end-to-end tests use an Anvil fork under
# chain ID 31337 with a throwaway key. Must match the wrapper's feeSigner.
# Generate a throwaway key with: cast wallet new
QUOTE_SIGNER_PRIVATE_KEY=
# Chains the local key may sign for: a subset of 84532,11155111,421614,31337 (the default).
# Any other chain ID is refused at startup; it can narrow the set, never extend it.
LOCAL_SIGNER_CHAIN_IDS=
