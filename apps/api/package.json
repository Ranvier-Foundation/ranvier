{
  "name": "@ranvier/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "eslint src scripts",
    "test": "vitest run --coverage",
    "kms:smoke": "tsx scripts/kms-smoke.ts",
    "check:aws-overrides": "tsx scripts/check-aws-overrides.ts",
    "balances:smoke": "tsx scripts/balances-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1141.0",
    "@ranvier/chains": "workspace:*",
    "@ranvier/fees": "workspace:*",
    "@ranvier/types": "workspace:*",
    "fastify": "5.12.5",
    "viem": "2.56.9",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
