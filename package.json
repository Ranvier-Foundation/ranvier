{
  "name": "ranvier",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:tokens": "pnpm --filter @ranvier/web guard:tokens",
    "e2e": "NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-http://127.0.0.1:3199} pnpm --filter @ranvier/web build && pnpm --filter @ranvier/web e2e",
    "harness:smoke": "pnpm --filter @ranvier/api harness:smoke",
    "harness:api": "pnpm --filter @ranvier/api harness:api",
    "guard:local-chain": "pnpm --filter @ranvier/api guard:local-chain"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.12.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "@vitest/coverage-v8": "5.0.3"
  }
}
